# =====================================================================
#  本地配置文件模板
#  用法：复制为 config/local.env，按本机环境填写；该文件不随源码提交。
#  PowerShell 启动脚本会自动读取并注入环境变量。
# =====================================================================

# ---- MySQL ----
LAB_DB_URL=jdbc:mysql://127.0.0.1:3306/labcare?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
LAB_DB_USERNAME=root
LAB_DB_PASSWORD=请填写本机 MySQL 密码

# ---- 后端 ----
LAB_SERVER_PORT=8080
# JWT 签名密钥：换成任意长随机串即可
LAB_JWT_SECRET=change-me-to-a-random-string
# AI 服务地址与服务间令牌（后端与 AI 服务必须一致）
LAB_AI_BASE_URL=http://127.0.0.1:8100
LAB_INTERNAL_TOKEN=labcare-internal-token-2026
# 知识库目录（绝对路径更稳妥）
LAB_KNOWLEDGE_DIR=F:/2026.11.2Project/data/知识库

# ---- 大模型（OpenAI 兼容接口，默认 DeepSeek）----
# 未填写时 RAG/Agent 自动进入降级模式：检索真实执行，回答为检索原文摘要
LAB_LLM_API_KEY=sk-851237c0ea484979aa9551eb5636b3db
LAB_LLM_BASE_URL=https://api.deepseek.com/v1
LAB_LLM_MODEL=deepseek-flash

# ---- 前端 ----
# 前端通过 Vite 代理访问后端，一般无需修改
