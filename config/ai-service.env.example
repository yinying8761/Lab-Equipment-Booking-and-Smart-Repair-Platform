# AI 服务配置模板：复制为 config/local.env 后填写真实值（local.env 不提交）
# 大模型（OpenAI 兼容接口，默认 DeepSeek）
LAB_LLM_API_KEY=sk-your-deepseek-key-here
LAB_LLM_BASE_URL=https://api.deepseek.com/v1
LAB_LLM_MODEL=deepseek-flash
LAB_LLM_TEMPERATURE=0.2

# 业务后端
LAB_BACKEND_BASE_URL=http://127.0.0.1:8080/api
LAB_INTERNAL_TOKEN=labcare-internal-token-2026

# 检索参数
LAB_CHUNK_SIZE=320
LAB_CHUNK_OVERLAP=60
LAB_TOP_K=4
LAB_MIN_SCORE=0.05
